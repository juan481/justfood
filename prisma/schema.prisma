// JustFood — Prisma schema
//
// Fase 0: Tenant, Branch, User (+ roles), TenantApiKey.
// Fase 1 adds: Category/Product (catálogo), Order/OrderItem/OrderStatusEvent
// (pedidos, canales web+mostrador), TableInventory/Reservation/Lead/PageView
// (ports directos del prototipo de PizzaZeka), TenantSettings/PaymentConfig/
// POSIntegrationConfig (reemplazo tipado de la tabla `config` KV), DeliveryZone.
// WaConversation/WaMessage/PaymentReceipt (agente de WhatsApp) llegan en Fase 2b-2d.
//
// Multitenancy strategy: shared schema, row-level `tenantId` on every
// tenant-owned table (see plan section 2) — same pattern as the CRM.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Supabase's transaction-mode pooler (port 6543) — what the app talks to
  // at runtime — doesn't support prepared statements, so `directUrl` (the
  // session-mode pooler on 5432, same host) is what `prisma db push` /
  // `migrate` actually use instead. Without this split, db push hangs
  // silently against the transaction pooler.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  COCINA
  CADETE
  MOSTRADOR
  // Fase 2 (Salón) — pantalla de Barra, ve solo los ítems de bebidas/tragos
  // de los pedidos de mesa, nunca comida ni precios/caja.
  BARRA
}

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  timezone  String   @default("America/Argentina/Buenos_Aires")
  status    String   @default("active")
  // Atomic per-tenant order counter — an `increment` UPDATE row-locks in
  // Postgres, so two orders created at the same instant (web + mostrador +
  // WhatsApp channels can all fire at once) still get distinct sequential
  // codes instead of racing on a separate COUNT(*) read (see createOrder()).
  orderSeq  Int      @default(0)
  // Tenant's own brand mark — a compressed data URL (same pattern as
  // PaymentReceipt.imageUrl), not a file path, so it needs no separate
  // storage service. Shown in the header, Home, and the printed comanda
  // instead of JustFood's own logo, once a tenant uploads one.
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches Branch[]
  users    User[]
  apiKeys  TenantApiKey[]

  categories           Category[]
  products             Product[]
  orders               Order[]
  tables               TableInventory[]
  // Mesas en vivo de Fase 2 (Salón) — ver comentario en el modelo Table.
  liveTables           Table[]
  reservations         Reservation[]
  leads                Lead[]
  pageViews            PageView[]
  settings             TenantSetting[]
  deliveryZones        DeliveryZone[]
  paymentConfig        PaymentConfig?
  posIntegrationConfig POSIntegrationConfig?
  paymentReceipts      PaymentReceipt[]
  couriers             Courier[]

  @@map("tenants")
}

model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  address   String?
  lat       Float?
  lng       Float?
  isDefault Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users         User[]
  orders        Order[]
  tables        TableInventory[]
  liveTables    Table[]
  reservations  Reservation[]
  deliveryZones DeliveryZone[]
  couriers      Courier[]

  @@index([tenantId])
  @@map("branches")
}

model User {
  id           String    @id @default(cuid())
  tenantId     String
  branchId     String?
  username     String
  passwordHash String
  role         UserRole
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id])

  // Username is globally unique (not just per tenant) so login never needs
  // a tenant hint — the username alone resolves which restaurant the staff
  // member belongs to.
  @@unique([username])
  @@index([tenantId])
  @@map("users")
}

model TenantApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  keyHash    String    @unique
  label      String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_api_keys")
}

// ─────────────────────────────────────────────────────────────────────────
// Fase 1 — catálogo, pedidos, y ports directos del prototipo de PizzaZeka
// ─────────────────────────────────────────────────────────────────────────

model Category {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  // A qué estación de preparación van los productos de esta categoría por
  // default (Fase 2 Salón) — un producto puede pisarlo con
  // Product.prepAreaOverride. Mismo criterio que isFrozen en Product: un
  // flag simple, no un sistema de tags.
  prepArea PrepArea @default(COCINA)

  @@index([tenantId])
  @@map("categories")
}

model Product {
  id              String   @id @default(cuid())
  tenantId        String
  categoryId      String?
  name            String
  description     String?
  // Whole pesos, matches PizzaZeka's `products.price INTEGER` convention
  // exactly — no cents, no floats.
  price           Int
  isActive        Boolean  @default(true)
  // "Congelados" merchandising flag, ported verbatim from the prototype
  // (products.is_frozen) rather than generalized into a tags system —
  // nothing in Fase 1 needs more than this yet.
  isFrozen        Boolean  @default(false)
  // null = hereda la estación de su categoría (Category.prepArea). Mismo
  // precedente que isFrozen: un flag, no un sistema de tags.
  prepAreaOverride PrepArea?
  sortOrder       Int      @default(0)
  imageUrl        String?
  // Original SQLite row id, kept for ETL traceability (plan section 7).
  legacyProductId Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category   Category?   @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]

  @@unique([tenantId, legacyProductId])
  @@index([tenantId])
  @@index([categoryId])
  @@map("products")
}

enum OrderChannel {
  WEB
  MOSTRADOR
  WHATSAPP
  // Fase 2 — pedido de salón, vinculado a una Table en vivo.
  DINE_IN
}

// Estación de preparación física (Fase 2 Salón) — a dónde se imprime/rutea
// cada ítem del pedido: cocina, barra, o directo de la heladera (sin ticket).
enum PrepArea {
  COCINA
  BARRA
  SIN_IMPRESION
}

// Estado en vivo de una mesa física (Fase 2 Salón). Verde/Rojo/Azul en la
// grilla — ver Table más abajo.
enum TableStatus {
  LIBRE
  OCUPADA
  // Pre-cuenta impresa (reversible, ver reopenTable) o pedido de mesa
  // cerrado con Mercado Pago/Transferencia esperando que un operador
  // apruebe el comprobante en /pagos — la mesa se queda acá hasta esa
  // aprobación, no se libera antes.
  ESPERANDO_PAGO
}

enum OrderStatus {
  // Pedidos de WhatsApp por transferencia caen acá hasta que un humano
  // aprueba el comprobante (Fase 2d) — invisibles para el tablero de KDS
  // mientras estén en este estado (plan sección 6).
  EN_ESPERA_PAGO
  NUEVO
  COCINA
  REPARTO
  ENTREGADO
  CANCELADO
}

model Order {
  id              String       @id @default(cuid())
  tenantId        String
  branchId        String
  orderCode       String
  channel         OrderChannel
  status          OrderStatus  @default(NUEVO)
  deliveryType    String       @default("delivery")
  customerName    String?
  customerPhone   String?
  address         String?
  locality        String?
  notes           String?
  // Texto libre, igual que el prototipo (server.js compara contra
  // 'efectivo' explícitamente, el resto son métodos digitales) — no
  // inventamos un enum que el prototipo no tiene.
  paymentMethod   String       @default("efectivo")
  paymentStatus   String       @default("pendiente")
  // totalAmount = suma de items + deliveryFee, siempre recalculado en el
  // server (nunca confiado del cliente). deliveryFee separado para poder
  // desglosarlo en el drawer/comanda impresa ("Subtotal productos" +
  // "Costo de envío" por separado).
  totalAmount     Int
  deliveryFee     Int          @default(0)
  // Copia denormalizada del nombre — se sigue mostrando en la comanda
  // impresa/drawer aunque el Courier se borre después. courierId es la
  // relación real, usada por el módulo Cadetes & Repartidores.
  courierName     String?
  courierId       String?
  // Efectivo cobrado por un cadete en la entrega, todavía sin "rendir" en
  // caja central — null mientras está pendiente, se completa al liquidar
  // (módulo Cadetes, "Rendición de Caja").
  cashSettledAt   DateTime?
  // Recalculado siempre en el server a partir de OrderItem — nunca se
  // confía en un total que mande el cliente (fix del bug del prototipo,
  // plan sección 7).
  idempotencyKey  String?
  createdByUserId String?
  // Optimistic concurrency para transiciones de estado (plan sección 7).
  version         Int          @default(0)
  legacyOrderId   Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Fase 2 (Salón) — solo tiene sentido con channel=DINE_IN. tableId es el
  // vínculo histórico permanente (muchos pedidos → una mesa en el tiempo);
  // Table.currentOrderId es el puntero efímero de "está ocupada ahora",
  // separado para poder limpiarlo al cerrar sin romper el historial.
  tableId      String?
  guestCount   Int?
  waiterUserId String?
  // Copia denormalizada, mismo criterio que courierName — se sigue
  // mostrando en la comanda/drawer aunque el User se borre después.
  waiterName   String?

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch  Branch   @relation(fields: [branchId], references: [id])
  courier Courier? @relation(fields: [courierId], references: [id])
  table   Table?   @relation("TableHistory", fields: [tableId], references: [id])
  // Relación inversa requerida por Table.currentOrderId — no se usa desde
  // el código de la app, solo existe para que Prisma arme la FK.
  tableAsCurrent Table? @relation("TableCurrentOrder")

  items           OrderItem[]
  statusEvents    OrderStatusEvent[]
  paymentReceipts PaymentReceipt[]

  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, legacyOrderId])
  @@index([tenantId, status])
  @@index([tenantId, channel])
  @@index([courierId])
  @@index([tableId])
  @@map("orders")
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  productId           String?
  productNameSnapshot String
  unitPriceSnapshot   Int
  quantity            Int      @default(1)
  notes               String?
  createdAt           DateTime @default(now())
  // Estación de preparación al momento de crear el ítem (Fase 2 Salón) —
  // igual criterio que productNameSnapshot/unitPriceSnapshot: una comanda
  // ya impresa nunca cambia de estación porque alguien editó la categoría
  // después. null para todo lo creado antes de esta fase.
  prepAreaSnapshot    PrepArea?
  // null = todavía pendiente en su estación; se completa cuando Cocina o
  // Barra lo marca listo.
  preparedAt          DateTime?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([prepAreaSnapshot, preparedAt])
  @@map("order_items")
}

model OrderStatusEvent {
  id              String       @id @default(cuid())
  orderId         String
  fromStatus      OrderStatus?
  toStatus        OrderStatus
  changedByUserId String?
  createdAt       DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_events")
}

// Fase 2 (Salón) — mesa física real, con estado en vivo. Distinto de
// TableInventory (abajo), que es solo un contador de "cuántas mesas de
// cada capacidad hay" para el módulo de reservas — no tiene identidad
// propia ni estado. Este modelo sí: Mesa 1, Mesa 2... Mesa 24, cada una
// con su color (TableStatus) y el pedido que tiene adentro ahora mismo.
model Table {
  id             String      @id @default(cuid())
  tenantId       String
  branchId       String
  number         Int
  capacity       Int         @default(4)
  status         TableStatus @default(LIBRE)
  // Puntero efímero al pedido en curso — null cuando la mesa está libre.
  // El historial completo de pedidos de esta mesa vive en
  // Order.tableId/orderHistory, que no se limpia nunca.
  currentOrderId String?     @unique
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch  @relation(fields: [branchId], references: [id])
  currentOrder Order?  @relation("TableCurrentOrder", fields: [currentOrderId], references: [id])
  orderHistory Order[] @relation("TableHistory")

  @@unique([tenantId, branchId, number])
  @@index([tenantId])
  @@map("tables")
}

model TableInventory {
  id       String  @id @default(cuid())
  tenantId String
  branchId String
  capacity Int
  quantity Int     @default(0)
  label    String?
  legacyId Int?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([tenantId, legacyId])
  @@index([tenantId])
  @@map("tables_inventory")
}

model Reservation {
  id                String   @id @default(cuid())
  tenantId          String
  branchId          String
  customerName      String
  customerPhone     String?
  reservationDate   String
  timeSlot          String
  peopleCount       Int
  tableCapacityUsed Int
  status            String   @default("confirmada")
  notes             String?
  legacyId          Int?
  createdAt         DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([tenantId, legacyId])
  @@index([tenantId])
  @@map("reservations")
}

model Lead {
  id        String   @id @default(cuid())
  tenantId  String
  email     String
  code      String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Distinto del prototipo (email UNIQUE global) — dos restaurantes
  // distintos pueden compartir un mismo cliente/email (plan sección 2).
  @@unique([tenantId, email])
  @@map("leads")
}

model PageView {
  id        String   @id @default(cuid())
  tenantId  String
  path      String
  referrer  String?
  userAgent String?
  ipHash    String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("page_views")
}

// Reemplazo flexible (KV) de la tabla `config` del prototipo, para los
// toggles de cola larga que no ameritan una columna propia (discount_*,
// module_*, whatsapp_number, kds_sound_enabled, business_name, etc.) —
// ver plan sección 2. Los valores con forma/uso bien definido (pagos, POS)
// se promueven a PaymentConfig/POSIntegrationConfig más abajo.
model TenantSetting {
  tenantId  String
  key       String
  value     String?
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, key])
  @@map("tenant_settings")
}

model PaymentConfig {
  tenantId               String   @id
  paymentAlias           String?
  paymentTitular         String?
  paymentCvu             String?
  // Encriptado con src/lib/crypto.ts — nunca texto plano (bug fijado
  // respecto al prototipo, que guarda esto en texto plano en `config`).
  mpAccessTokenEncrypted String?
  mpEnabled              Boolean  @default(false)
  cashEnabled            Boolean  @default(true)
  updatedAt              DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("payment_configs")
}

model POSIntegrationConfig {
  tenantId          String    @id
  provider          String    @default("fudo")
  enabled           Boolean   @default(false)
  apiTokenEncrypted String?
  businessId        String?
  lastSyncAt        DateTime?
  lastSyncStatus    String?
  updatedAt         DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("pos_integration_configs")
}

// STANDARD = catálogo general (pizzas, bebidas, etc.); FROZEN = productos
// con `Product.isFrozen`; ALL = una sola zona cubre todo el tenant (default
// histórico, sigue sirviendo a cualquier tenant que no separe congelados).
enum DeliveryZoneScope {
  ALL
  STANDARD
  FROZEN
}

model DeliveryZone {
  id           String            @id @default(cuid())
  tenantId     String
  branchId     String
  name         String
  // "radius" para el modelo plano actual de PizzaZeka; "polygon" queda
  // listo para cuando un tenant lo necesite (plan sección 7) sin rediseño.
  type         String            @default("radius")
  scope        DeliveryZoneScope @default(ALL)
  radiusKm     Float?
  cost         Int
  minOrderCost Int?
  isActive     Boolean           @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([tenantId, scope])
  @@index([tenantId])
  @@map("delivery_zones")
}

// ─────────────────────────────────────────────────────────────────────────
// Fase 2d — cola "Pagos por Revisar" (schema + UI construidos ahora, contra
// datos de prueba; la extracción real por Gemini Vision llega recién cuando
// haya GEMINI_API_KEY — ver plan sección 6.4).
// ─────────────────────────────────────────────────────────────────────────

enum ReceiptAutoValidationStatus {
  MATCH
  AMOUNT_MISMATCH
  ALIAS_MISMATCH
  DUPLICATE
  UNREADABLE
  // Sin extracción automática todavía — comprobante cargado a mano o el
  // paso de Gemini Vision no corrió (fallback mientras no haya API key).
  PENDING_EXTRACTION
}

enum ReceiptFinalStatus {
  PENDING
  APPROVED
  REJECTED
}

model PaymentReceipt {
  id       String @id @default(cuid())
  tenantId String
  orderId  String

  imageUrl String

  // Campos que va a llenar Gemini Vision (Fase 2d real) — nullable porque
  // por ahora se cargan a mano o quedan sin extraer.
  extractedAmount          Int?
  extractedAliasOrCvu      String?
  extractedOperationNumber String?
  extractedAt              DateTime?
  aiRawResponse            String?

  autoValidationStatus ReceiptAutoValidationStatus @default(PENDING_EXTRACTION)

  reviewedByUserId String?
  reviewedAt       DateTime?
  finalStatus      ReceiptFinalStatus @default(PENDING)

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Índice de deduplicación: un mismo número de operación no puede
  // aprobarse dos veces para el mismo tenant (plan sección 6.4).
  @@index([tenantId, extractedOperationNumber])
  @@index([tenantId, finalStatus])
  @@map("payment_receipts")
}

// ─────────────────────────────────────────────────────────────────────────
// Cadetes & Repartidores — reemplaza el Order.courierName de texto libre
// por una flota real, visible también como contador en vivo en el Comandero.
// ─────────────────────────────────────────────────────────────────────────

enum CourierStatus {
  DISPONIBLE
  EN_VIAJE
  INACTIVO
}

model Courier {
  id                String        @id @default(cuid())
  tenantId          String
  branchId          String
  firstName         String
  lastName          String
  phone             String?
  vehicle           String?
  plate             String?
  // Comisión fija por envío — "Tarifa por Envío" en el alta rápida.
  tariffPerDelivery Int           @default(0)
  // Habilitado para el turno de hoy — se puede desactivar sin borrar el
  // registro (vacaciones, franco, etc.).
  isActiveToday     Boolean       @default(true)
  status            CourierStatus @default(DISPONIBLE)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id])
  orders Order[]

  @@index([tenantId])
  @@map("couriers")
}
