# Local dev DB (docker-compose.yml spins up this exact instance)
DATABASE_URL="postgresql://justfood:justfood_dev@localhost:5434/justfood?schema=public"

# NextAuth — generate a real secret for any deployed environment with:
#   openssl rand -base64 32
NEXTAUTH_SECRET="dev-only-secret-change-me"
NEXTAUTH_URL="http://localhost:3010"

# Internal port this app listens on (matches server.ts).
# 3006 is already used by just-create-web on the VPS — keep 3010 free for JustFood.
PORT=3010

# Secret used to encrypt MP/Fudo tokens at rest (PaymentConfig/POSIntegrationConfig).
# Generate a real one per environment with: openssl rand -base64 32
ENCRYPTION_KEY="dev-only-encryption-key-change-me"

# Filled in during Phase 2b+ (WhatsApp agent) — not needed for Phase 0/1.
# GEMINI_API_KEY=
# WHATSAPP_CLOUD_API_TOKEN=
# WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=
# GOOGLE_GEOCODING_API_KEY=
